# ===== Telegram =====
# Token von @BotFather (Telegram): /newbot -> Token hier einfügen
TELEGRAM_BOT_TOKEN=
# Deine Chat-ID: schreibe deinem Bot eine Nachricht, dann öffne
# https://api.telegram.org/bot<TOKEN>/getUpdates und kopiere "chat":{"id":...}
# (oder nutze python -m bot.wizard, der findet sie automatisch)
TELEGRAM_CHAT_ID=

# ===== Search filters (set by `python -m bot.wizard`) =====
# Rooms: "3" exact, "3-3.5" range, "2-4", or "3+". Overrides config.yaml.
SEARCH_ROOMS=3-3.5
# Göttingen postal codes to limit to, comma-separated (blank = all of Göttingen).
# PLZ: 37073 37075 37077 37079 37081 37083 37085
SEARCH_POSTAL_CODES=

# ===== Kleinanzeigen login (for auto-messaging) =====
# Set these with:  python -m bot.credentials   (password entered hidden)
KLEINANZEIGEN_EMAIL=
KLEINANZEIGEN_PASSWORD=

# ===== Personal data used to fill the Kleinanzeigen contact form fields =====
FULL_NAME=
EMAIL=
PHONE=
OCCUPATION=
HOUSEHOLD=
